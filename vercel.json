{
  "version": 2,
  "name": "sistema-precatorios",
  "functions": {
    "api/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/trf1.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/trf2.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/trf3.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/trf4.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/trf5.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/trf6.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/trf1",
      "dest": "/api/trf1.js"
    },
    {
      "src": "/api/trf2",
      "dest": "/api/trf2.js"
    },
    {
      "src": "/api/trf3",
      "dest": "/api/trf3.js"
    },
    {
      "src": "/api/trf4",
      "dest": "/api/trf4.js"
    },
    {
      "src": "/api/trf5",
      "dest": "/api/trf5.js"
    },
    {
      "src": "/api/trf6",
      "dest": "/api/trf6.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
