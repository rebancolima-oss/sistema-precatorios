{
  "version": 2,
  "name": "sistema-precatorios",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/datajud.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/datajud",
      "dest": "/api/datajud.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
