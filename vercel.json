{
  "version": 2,
  "name": "sistema-precatorios",
  "functions": {
    "api/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/consultar.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/consultar",
      "dest": "/api/consultar.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
